servidor-arquivado/backend/models/
servidor-arquivado/backend/uploads/*
!servidor-arquivado/backend/uploads/.gitkeep
!servidor-arquivado/backend/uploads/cloned_samples/
servidor-arquivado/backend/uploads/cloned_samples/*
!servidor-arquivado/backend/uploads/cloned_samples/.gitkeep

